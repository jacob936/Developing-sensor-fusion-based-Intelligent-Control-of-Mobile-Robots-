#!/usr/bin/env python3
"""
Safety Layer using Artificial Potential Field
Modifies reference trajectory to avoid obstacles
"""

import rclpy
from rclpy.node import Node
from sensor_msgs.msg import LaserScan
from nav_msgs.msg import Path
from geometry_msgs.msg import PoseStamped
import numpy as np
import math

class SafetyLayer(Node):
    def __init__(self):
        super().__init__('safety_layer_node')
        
        # APF parameters
        self.obstacle_threshold = 0.5  # meters
        self.repulsive_gain = 1.0
        self.safe_distance = 0.3
        
        # State
        self.scan_data = None
        self.input_path = None
        self.robot_position = None
        
        # Subscribers
        self.scan_sub = self.create_subscription(
            LaserScan, '/scan', self.scan_callback, 10)
        
        self.path_sub = self.create_subscription(
            Path, '/reference_path', self.path_callback, 10)
        
        # Publisher
        self.safe_path_pub = self.create_publisher(Path, '/safe_reference_path', 10)
        
        self.get_logger().info('Safety Layer initialized')
    
    def scan_callback(self, msg):
        """Receive LiDAR scan data"""
        self.scan_data = msg
    
    def path_callback(self, msg):
        """Receive reference path and apply obstacle avoidance"""
        self.input_path = msg
        safe_path = self.apply_potential_field(msg)
        self.safe_path_pub.publish(safe_path)
    
    def apply_potential_field(self, path):
        """Apply artificial potential field to avoid obstacles"""
        if self.scan_data is None:
            return path
        
        safe_path = Path()
        safe_path.header = path.header
        
        # Convert scan to numpy array
        ranges = np.array(self.scan_data.ranges)
        angles = np.linspace(self.scan_data.angle_min, 
                           self.scan_data.angle_max, 
                           len(ranges))
        
        for pose in path.poses:
            new_pose = PoseStamped()
            new_pose.header = pose.header
            
            # Check for obstacles in direction of this waypoint
            dx = pose.pose.position.x - 0  # Assuming robot at origin
            dy = pose.pose.position.y - 0
            direction_angle = math.atan2(dy, dx)
            
            # Find closest obstacle in this direction
            angle_diff = np.abs(angles - direction_angle)
            angle_diff = np.minimum(angle_diff, 2*np.pi - angle_diff)
            
            # Get obstacles within 30 degrees
            mask = angle_diff < np.deg2rad(30)
            if np.any(mask):
                close_ranges = ranges[mask]
                min_range = np.min(close_ranges[close_ranges < 2.0])  # Within 2m
                
                # If obstacle too close, modify waypoint
                if min_range < self.obstacle_threshold:
                    # Push waypoint away from obstacle
                    repulsive_force = self.repulsive_gain * (1/min_range - 1/self.obstacle_threshold)
                    
                    # Simple avoidance: shift perpendicular to obstacle
                    new_pose.pose.position.x = pose.pose.position.x
                    new_pose.pose.position.y = pose.pose.position.y + repulsive_force * 0.1
                    new_pose.pose.orientation = pose.pose.orientation
                else:
                    new_pose = pose
            else:
                new_pose = pose
            
            safe_path.poses.append(new_pose)
        
        return safe_path

def main(args=None):
    rclpy.init(args=args)
    safety_node = SafetyLayer()
    rclpy.spin(safety_node)
    safety_node.destroy_node()
    rclpy.shutdown()

import os
os.environ['ROS_DISTRO'] = 'jazzy'
if __name__ == '__main__':
    main()

